# Copy to .airlock/env for local, untracked experiment-specific overrides.
#
# These values override .airlock/config.json for setup and verification without
# changing tracked repository files.

# Point at an ignored structured config if your MCP/tool choices are private.
# AIRLOCK_CONFIG=.airlock/config.local.json
# AIRLOCK_REQUIRED_COMMANDS="node npm git curl jq claude"
# AIRLOCK_FORBIDDEN_COMMANDS="example-cli another-cli"
# AIRLOCK_FORBIDDEN_ENV_PATTERN="EXAMPLE_VENDOR|ANOTHER_VENDOR"
# AIRLOCK_PRIOR_TRACE_PATTERN="(^|/)(environment|evidence-index|raw-log|findings)\\.md$|(^|/)(evidence|artifacts)(/|$)"
# AIRLOCK_ALLOWED_MCP_SERVERS="playwright"
# AIRLOCK_ARCHIVE_ROOT="/path/to/durable/archive"
