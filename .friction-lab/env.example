# Copy to .friction-lab/env for local, untracked experiment-specific overrides.
#
# These values override .friction-lab/config.json for setup and verification without
# changing tracked repository files.

# Point at an ignored structured config if your MCP/tool choices are private.
# FRICTION_LAB_CONFIG=.friction-lab/config.local.json
# FRICTION_LAB_REQUIRED_COMMANDS="node npm git curl jq claude"
# FRICTION_LAB_FORBIDDEN_COMMANDS="example-cli another-cli"
# FRICTION_LAB_FORBIDDEN_ENV_PATTERN="EXAMPLE_VENDOR|ANOTHER_VENDOR"
# FRICTION_LAB_PRIOR_TRACE_PATTERN="(^|/)(environment|evidence-index|raw-log|findings)\\.md$|(^|/)(evidence|artifacts)(/|$)"
# FRICTION_LAB_ALLOWED_MCP_SERVERS="playwright"
# FRICTION_LAB_ARCHIVE_ROOT="/path/to/durable/archive"
