{
  "requiredCommands": [
    "node",
    "npm",
    "git",
    "curl",
    "jq",
    "claude"
  ],
  "agents": [
    {
      "id": "executor",
      "role": "executor",
      "name": "Claude Code",
      "command": "claude",
      "mcpProvider": "claude"
    },
    {
      "id": "reviewer",
      "role": "reviewer",
      "name": "Codex",
      "command": "",
      "mcpProvider": "none",
      "required": false,
      "notes": "External reviewer/lab-tech agent; not installed or configured inside the container by this profile."
    }
  ],
  "reviewProtocol": {
    "mode": "cross-review",
    "description": "The executor produces evidence and findings. The reviewer examines the evidence, challenges conclusions, and decides whether to return to the executor or escalate to the human.",
    "handoffArtifacts": [
      "environment.md",
      "raw-log.md",
      "evidence-index.md",
      "findings.md",
      "evidence/",
      "artifacts/"
    ]
  },
  "forbiddenCommands": [],
  "forbiddenEnvPattern": "",
  "priorTracePattern": "(^|/)(environment|evidence-index|raw-log|findings)\\.md$|(^|/)(evidence|artifacts)(/|$)|(^|/)\\.playwright-mcp(/|$)",
  "allowedMcpServers": [
    "playwright"
  ],
  "npmGlobalPackages": [
    "@anthropic-ai/claude-code",
    "playwright",
    "@playwright/mcp"
  ],
  "playwrightBrowsers": [
    "chromium"
  ],
  "playwrightMcpBrowsers": [
    "chrome-for-testing"
  ],
  "mcpServers": [
    {
      "name": "playwright",
      "command": "playwright-mcp",
      "args": [
        "--isolated",
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox",
        "--output-dir",
        "/tmp/playwright-mcp"
      ],
      "requiredCommands": [
        "playwright",
        "playwright-mcp"
      ],
      "smokeTest": "example.com-accessibility-snapshot"
    }
  ]
}
